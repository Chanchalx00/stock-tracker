NEXT_PUBLIC_API_URL=http://localhost:5000/api
NEXT_PUBLIC_SOCKET_URL=http://localhost:5000

# Google Sign-In — the OAuth Client ID (not the secret) from Google Cloud
# Console. Baked into the client bundle at build time, so it must be set
# before `next dev` / `next build` — restart the dev server after adding it.
#
# How to get one:
#   1. https://console.cloud.google.com/ → select or create a project.
#   2. APIs & Services → OAuth consent screen → configure it (External is
#      fine for testing) and add your own email as a test user if the app
#      stays in "Testing" publishing status.
#   3. APIs & Services → Credentials → Create Credentials →
#      OAuth client ID → Application type: Web application.
#   4. Authorized JavaScript origins: add http://localhost:3000
#      (and your production frontend origin later).
#   5. Authorized redirect URIs: not needed for this flow (Google Identity
#      Services' One Tap / button posts a credential directly, no redirect).
#   6. Copy the generated Client ID below. Put the SAME value in
#      backend/.env as GOOGLE_CLIENT_ID (the backend verifies tokens
#      against it) — the Client Secret on that screen is not used at all
#      by this flow and does not need to go anywhere.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# Sentry error tracking (optional). NEXT_PUBLIC_SENTRY_DSN is safe to be
# public — a DSN only accepts events, it can't read anything back. Same
# project's DSN can be reused for SENTRY_DSN (server-side/SSR errors).
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_DSN=
