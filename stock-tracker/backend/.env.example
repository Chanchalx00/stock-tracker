# Server
PORT=5000
NODE_ENV=development

# MongoDB
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/stock-tracker

# JWT — short-lived access token (returned in the response body, kept in
# memory on the frontend) + long-lived refresh token (httpOnly cookie,
# stored server-side only as a hash). See src/services/token.service.js.
JWT_SECRET=replace-with-a-long-random-string
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY_DAYS=30

# Redis (optional — quote/news/search caching degrades gracefully without it)
REDIS_URL=redis://localhost:6379
# Upstash example: rediss://default:password@region.upstash.io:6379

# CORS — must match the frontend origin(s) exactly (protocol + host +
# port). Comma-separate multiple origins, e.g. a staging URL alongside prod.
CLIENT_URL=http://localhost:3000

# Google Sign-In (optional) — OAuth Client ID from Google Cloud Console,
# same value as the frontend's NEXT_PUBLIC_GOOGLE_CLIENT_ID. Used to
# verify Google ID tokens in src/controllers/auth.controller.js. Without
# it, POST /api/auth/google returns 500. See frontend/.env.example for
# how to obtain one.
GOOGLE_CLIENT_ID=

# Sentry error tracking (optional) — DSN from a project at sentry.io (or
# a self-hosted instance). Without it, errors are only logged locally.
SENTRY_DSN=

# SMTP (optional) — sends "forgot password" reset emails. Without it, the
# reset link is logged server-side instead (see src/services/email.service.js),
# which is enough to test the flow locally without a real mail provider.
# Example values for Gmail (use an App Password, not your real password):
#   SMTP_HOST=smtp.gmail.com
#   SMTP_PORT=587
#   SMTP_SECURE=false
#   SMTP_USER=you@gmail.com
#   SMTP_PASS=<app password>
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="Stocklytics <no-reply@example.com>"

# Logging
LOG_LEVEL=debug
LOG_DIR=logs
